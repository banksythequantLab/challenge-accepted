# Copy to .env and fill in. Never commit .env.

# --- Model access -----------------------------------------------------------
# Option A: Gemini API (fastest to start)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key

# Option B: Vertex AI (use this for the submission -- counts as a GCP service)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models -----------------------------------------------------------------
# The hackathon requires "Gemini 3.5 or newer". As of Aug 2026 that means the
# 3.5/3.6 Flash family only -- gemini-3.1-pro-preview does NOT qualify.
CA_MODEL_REASONING=gemini-3.6-flash
CA_MODEL_CHEAP=gemini-3.5-flash-lite

# --- Managed services (optional locally) ------------------------------------
# AGENT_ENGINE_ID=projects/.../locations/us-central1/reasoningEngines/...
# CA_SANDBOX_RESOURCE_NAME=projects/.../sandboxes/...

# --- Behaviour --------------------------------------------------------------
CA_MIN_QUESTIONS=5
CA_MAX_QUESTIONS=9
CA_MIN_NODES=8
CA_MAX_NODES=20
CA_FORGE_WORKERS=4

# Force the in-memory store even when GOOGLE_CLOUD_PROJECT is set
# CA_FORCE_MEMORY_DB=1
